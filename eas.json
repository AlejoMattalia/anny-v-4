{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "22.17.0",
      "ios": {
        "simulator": false
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "environment": "preview",
      "node": "22.17.0",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "node": "22.17.0",
      "autoIncrement": true
    }
  }
}
